rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anyone can read flights, but only admins can modify
    match /flights/{flightId} {
      allow read: if request.auth != null;
      allow write: if false;  // Only allow through Admin SDK
    }

    // Users can read their own bookings and create new ones
    match /bookings/{bookingId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;  // Only allow through Admin SDK
    }
  }
}

