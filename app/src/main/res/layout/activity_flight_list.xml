<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activities.FlightListActivity">

    <!-- Header / Title -->
    <TextView
        android:id="@+id/tvFlightListTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available Flights"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/teal_700"
        android:textColor="@android:color/white" />

    <!-- RecyclerView for displaying flights -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewFlights"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_flight" />

    <!-- Back to Search Button -->
    <Button
        android:id="@+id/btnBackToSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:backgroundTint="@color/teal_700"
        android:text="Back to Search"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textStyle="bold" />

</LinearLayout>
