<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activities.MyBookingsActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/tvMyBookingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Bookings"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/teal_700"
        android:textColor="@android:color/white" />

    <!-- RecyclerView to display list of bookings -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewBookings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_booking" />

    <!-- No Bookings Text (visible if list empty) -->
    <TextView
        android:id="@+id/tvNoBookings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No bookings found."
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        android:textColor="@color/black" />

    <!-- Back Button -->
    <Button
        android:id="@+id/btnBackToHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:layout_margin="12dp"
        android:backgroundTint="@color/teal_700"
        android:textColor="@android:color/white" />

</LinearLayout>
